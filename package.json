{
  "name": "cardspoke",
  "version": "0.21.1",
  "description": "A lightweight, local-first card-based knowledge app",
  "scripts": {
    "test": "uvu tests -i helpers",
    "test:watch": "uvu tests -i helpers --watch",
    "build": "node scripts/build-plugin-worker.mjs && vite build",
    "dev": "node scripts/build-plugin-worker.mjs && vite",
    "build:plugin-worker": "node scripts/build-plugin-worker.mjs",
    "preview": "vite preview",
    "smoke": "node scripts/static-smoke.mjs",
    "qa:browser": "node scripts/browser-qa.mjs",
    "platform:android": "npx cap add android",
    "platform:ios": "npx cap add ios",
    "sync": "npm run build && npx cap sync",
    "sync:android": "npm run build && npx cap sync android",
    "sync:ios": "npm run build && npx cap sync ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "desktop:install": "npm ci --prefix desktop",
    "desktop:start": "npm run start --prefix desktop",
    "desktop:dist": "npm run dist --prefix desktop",
    "desktop:test": "npm test --prefix desktop"
  },
  "keywords": [
    "knowledge-base",
    "notes",
    "cards",
    "local-first",
    "capacitor",
    "cross-platform",
    "responsive",
    "mobile"
  ],
  "author": "Jeffrey Guntly <https://github.com/jxburros>",
  "license": "Apache-2.0",
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/ios": "^7.4.4",
    "@capacitor/preferences": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "esbuild": "^0.28.1",
    "playwright": "1.61.1",
    "typescript": "^5.9.3",
    "uvu": "^0.5.6",
    "vite": "^7.3.1"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
